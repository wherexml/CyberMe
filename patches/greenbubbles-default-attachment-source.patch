+fn validate_attachment_parent_chain(account_root: &Path, path: &Path) -> Result<(), LiveAttachmentError> {
+    let relative = path.strip_prefix(account_root).map_err(|_| {
+        LiveAttachmentError::UnsafeSource("attachment parent escaped its account".into())
+    })?;
+    validate_relative_path(relative)?;
+    let mut current = account_root.to_path_buf();
+    let count = relative.components().count();
+    for component in relative.components().take(count.saturating_sub(1)) {
+        current.push(component);
+        let metadata = fs::symlink_metadata(&current)?;
+        if metadata.file_type().is_symlink() || !metadata.is_dir()
+            || metadata.uid() != unsafe { libc::geteuid() }
+            || current.canonicalize()? != current
+        {
+            return Err(LiveAttachmentError::UnsafeSource("attachment parent contains a symbolic link or invalid directory".into()));
+        }
+    }
+    Ok(())
 }
 
